# Copia este archivo como .env (en api-backend/) para desarrollo local con Docker
# Estos valores los lee application.properties vía variables de entorno

DB_URL=jdbc:sqlserver://<tu-servidor>.database.windows.net:1433;database=<tu-bd>;encrypt=true
DB_USERNAME=<usuario>
DB_PASSWORD=<password>
JWT_SECRET=<clave-secreta-jwt>
